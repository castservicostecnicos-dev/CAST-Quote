{
  "entities": {
    "Company": {
      "title": "Company",
      "description": "Empresas cadastradas no ecossistema CAST Quote",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "cnpj": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "logo_url": { "type": "string" },
        "primary_color": { "type": "string" },
        "active": { "type": "number" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "User": {
      "title": "User",
      "description": "Usuários autorizados no sistema com perfis de acesso",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "company_id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["DEV", "ADM", "GERENTE", "SUPERVISOR", "TÉCNICO"] },
        "active": { "type": "number" },
        "avatar_url": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "email", "name", "role"]
    },
    "Quote": {
      "title": "Quote",
      "description": "Orçamentos e propostas comerciais emitidas",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "company_id": { "type": "string" },
        "quote_number": { "type": "number" },
        "client_id": { "type": "string" },
        "client_name": { "type": "string" },
        "client_phone": { "type": "string" },
        "client_email": { "type": "string" },
        "technician_id": { "type": "string" },
        "technician_name": { "type": "string" },
        "created_by": { "type": "string" },
        "date": { "type": "string" },
        "validity_date": { "type": "string" },
        "status": { "type": "string", "enum": ["Rascunho", "Enviado", "Aprovado", "Recusado"] },
        "description": { "type": "string" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "addition": { "type": "number" },
        "total": { "type": "number" },
        "notes": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["id", "company_id", "quote_number", "client_name", "total"]
    },
    "WorkOrder": {
      "title": "WorkOrder",
      "description": "Ordens de Serviço para execução técnica em campo",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "company_id": { "type": "string" },
        "order_number": { "type": "number" },
        "quote_id": { "type": "string" },
        "client_id": { "type": "string" },
        "client_name": { "type": "string" },
        "technician_id": { "type": "string" },
        "technician_name": { "type": "string" },
        "created_by": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string", "enum": ["Aberta", "Em Andamento", "Concluída", "Cancelada"] },
        "description": { "type": "string" },
        "labor_cost": { "type": "number" },
        "parts_cost": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "notes": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["id", "company_id", "order_number", "client_name", "total"]
    },
    "Client": {
      "title": "Client",
      "description": "Clientes e contratantes corporativos e residenciais",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "company_id": { "type": "string" },
        "name": { "type": "string" },
        "document": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "notes": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Technician": {
      "title": "Technician",
      "description": "Técnicos especialistas e equipe de execução",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "company_id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "role_title": { "type": "string" },
        "active": { "type": "number" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "name"]
    }
  },
  "firestore": {
    "/companies/{companyId}": {
      "schema": "Company",
      "description": "Coleção de empresas cadastradas"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Coleção de usuários do sistema"
    },
    "/quotes/{quoteId}": {
      "schema": "Quote",
      "description": "Coleção de orçamentos e propostas comerciais"
    },
    "/work_orders/{orderId}": {
      "schema": "WorkOrder",
      "description": "Coleção de ordens de serviço"
    },
    "/clients/{clientId}": {
      "schema": "Client",
      "description": "Coleção de clientes"
    },
    "/technicians/{technicianId}": {
      "schema": "Technician",
      "description": "Coleção de técnicos cadastrados"
    }
  }
}
